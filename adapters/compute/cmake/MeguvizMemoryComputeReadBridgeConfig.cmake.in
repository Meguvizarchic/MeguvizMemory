@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(MeguvizMemory CONFIG REQUIRED)
find_dependency(MeguvizCompute CONFIG REQUIRED)
include(CheckCXXSourceCompiles)
set(_mgmem_bridge_saved_required_libraries "${CMAKE_REQUIRED_LIBRARIES}")
set(CMAKE_REQUIRED_LIBRARIES MeguvizMemory::mgmem)
unset(_mgmem_bridge_has_checked_release CACHE)
check_cxx_source_compiles("#include <mgmem/mgmem.h>
int main() { return (int)mgmem_import_external_checked_v1(nullptr, nullptr, nullptr); }"
  _mgmem_bridge_has_checked_release)
set(CMAKE_REQUIRED_LIBRARIES "${_mgmem_bridge_saved_required_libraries}")
unset(_mgmem_bridge_saved_required_libraries)
if(NOT _mgmem_bridge_has_checked_release)
  message(FATAL_ERROR "MeguvizMemoryComputeReadBridge requires a Memory SDK with checked external release; ABI 1.1 alone is insufficient")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryComputeReadBridgeTargets.cmake")
set(MeguvizMemoryComputeReadBridge_read_bridge_FOUND TRUE)
if("arena_read_bridge" IN_LIST MeguvizMemoryComputeReadBridge_FIND_COMPONENTS)
  set(MeguvizMemoryComputeReadBridge_arena_read_bridge_FOUND FALSE)
  if(TARGET MeguvizMemoryComputeReadBridge::arena_read_bridge)
    set(_mgmem_bridge_saved_required_libraries "${CMAKE_REQUIRED_LIBRARIES}")
    set(CMAKE_REQUIRED_LIBRARIES MeguvizMemory::mgmem)
    unset(_mgmem_bridge_has_arena_release CACHE)
    check_cxx_source_compiles("#include <mgmem/mgmem.h>
int main() { return (int)mgmem_import_external_arena_checked_v1(nullptr, nullptr, nullptr) + (int)MGMEM_CAP_ARENA_EXTERNAL_IMPORT; }"
      _mgmem_bridge_has_arena_release)
    set(CMAKE_REQUIRED_LIBRARIES "${_mgmem_bridge_saved_required_libraries}")
    unset(_mgmem_bridge_saved_required_libraries)
    if(_mgmem_bridge_has_arena_release)
      set(MeguvizMemoryComputeReadBridge_arena_read_bridge_FOUND TRUE)
    endif()
  endif()
  if(NOT MeguvizMemoryComputeReadBridge_arena_read_bridge_FOUND)
    set(MeguvizMemoryComputeReadBridge_NOT_FOUND_MESSAGE "Arena READ bridge requires the arena target and a Memory SDK with checked arena import")
  endif()
endif()
check_required_components(MeguvizMemoryComputeReadBridge)
