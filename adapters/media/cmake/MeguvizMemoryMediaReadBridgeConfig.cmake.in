@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(MeguvizMemoryMediaReadBridge_FIND_REQUIRED_arena_read_bridge)
  find_dependency(MeguvizMemoryComputeReadBridge CONFIG REQUIRED COMPONENTS arena_read_bridge)
else()
  find_dependency(MeguvizMemoryComputeReadBridge CONFIG REQUIRED)
endif()
find_dependency(MeguvizMedia CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryMediaReadBridgeTargets.cmake")
set(MeguvizMemoryMediaReadBridge_read_bridge_FOUND FALSE)
set(MeguvizMemoryMediaReadBridge_arena_read_bridge_FOUND FALSE)
if(TARGET MeguvizMemoryMediaReadBridge::read_bridge)
  set(MeguvizMemoryMediaReadBridge_read_bridge_FOUND TRUE)
endif()
if(TARGET MeguvizMemoryMediaReadBridge::arena_read_bridge)
  set(MeguvizMemoryMediaReadBridge_arena_read_bridge_FOUND TRUE)
endif()
check_required_components(MeguvizMemoryMediaReadBridge)
