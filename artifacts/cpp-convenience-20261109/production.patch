+}
+
+void scoped_failure() {
+    // These origins outlive the deliberately quarantined native domains.
+    static Origin origins[6];
+    for (unsigned scenario = 0; scenario < 6; ++scenario) {
+        auto &origin = origins[scenario];
+        origin.release_status = MGMEM_BUSY;
